---
// Scroll-reveal wrapper. Adds [data-reveal] which global.css animates.
// A single shared IntersectionObserver handles every reveal on the page.
interface Props {
  delay?: 0 | 1 | 2 | 3 | 4;
  as?: string;
  class?: string;
}
const { delay = 0, as = 'div', class: className = '' } = Astro.props;
const Tag = as as any;
---

<Tag data-reveal data-reveal-delay={delay} class={className}>
  <slot />
</Tag>

<script>
  // Runs once per page. Shared observer for all [data-reveal] elements.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const els = document.querySelectorAll('[data-reveal]');
  if (reduce) {
    els.forEach((el) => el.classList.add('is-visible'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
    );
    els.forEach((el) => io.observe(el));
  }
</script>
