---
// Stats band — 4 metrics with count-up on scroll into view.
// Number on top, label underneath. Lucide line-icons per metric.
import { stats } from '../../data/site';
import Reveal from '../Reveal.astro';

// Inline Lucide icons (ISC license) — one per metric, in order.
// calendar-clock, layers, globe, users
const icons = [
  '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><circle cx="16" cy="16" r="4"/><path d="M16 14.5V16l1 1"/>',
  '<path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>',
  '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
  '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
];
---

<section class="section stats below-fold" aria-label="Cifras de Morris & Opazo">
  <div class="container">
    <div class="stats__divider" aria-hidden="true"></div>
    <ul class="stats__grid" role="list">
      {
        stats.map((stat, i) => (
          <Reveal as="li" delay={(i % 5) as 0 | 1 | 2 | 3 | 4} class="stats__item">
            <span class="stats__icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i]} />
            </span>
            <span
              class="stats__value"
              data-count
              data-target={stat.target}
              data-prefix={stat.prefix}
              data-suffix={stat.suffix}
            >
              {stat.value}
            </span>
            <span class="stats__label">{stat.label}</span>
          </Reveal>
        ))
      }
    </ul>
    <div class="stats__divider" aria-hidden="true"></div>
  </div>
</section>

<style>
  .stats__divider {
    height: 1px;
    background: linear-gradient(
      90deg, transparent, var(--line) 15%,
      rgba(139, 124, 255, 0.5) 50%, var(--line) 85%, transparent
    );
  }
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    list-style: none;
    margin: 0;
    padding: clamp(2.5rem, 5vw, 4rem) 0;
  }
  .stats__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.85rem;
  }
  .stats__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    color: var(--brand-400);
    background: rgba(139, 124, 255, 0.10);
    border: 1px solid var(--line);
  }
  .stats__value {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.75rem, 1.6rem + 4vw, 4.25rem);
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    background: var(--grad-flow);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .stats__label {
    display: block;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
    max-width: 16ch;
    line-height: 1.5;
  }
  @media (max-width: 720px) {
    .stats__grid { grid-template-columns: repeat(2, 1fr); gap: 2.5rem 1.5rem; }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nodes = document.querySelectorAll<HTMLElement>('[data-count]');

  const render = (el: HTMLElement, n: number) => {
    const prefix = el.dataset.prefix ?? '';
    const suffix = el.dataset.suffix ?? '';
    el.textContent = `${prefix}${n}${suffix}`;
  };

  // Start each counter at 0 up-front so the count-up is visible on reveal.
  if (!reduce) nodes.forEach((el) => render(el, 0));

  const animate = (el: HTMLElement) => {
    const target = Number(el.dataset.target ?? '0');
    if (reduce) { render(el, target); return; }
    // Even small targets animate; "+1K" counts 0 -> 1 with the K suffix.
    const duration = 1600;
    const start = performance.now();
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    const step = (now: number) => {
      const t = Math.min((now - start) / duration, 1);
      render(el, Math.round(ease(t) * target));
      if (t < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  if (reduce) {
    nodes.forEach((el) => animate(el));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            animate(entry.target as HTMLElement);
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.4 }
    );
    nodes.forEach((el) => io.observe(el));
  }
</script>
