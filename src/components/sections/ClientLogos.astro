---
// ClientLogos — quiet, low-contrast trust strip.
// Gentle auto-scroll marquee; static centered row on prefers-reduced-motion.
import { clients } from '../../data/site';

// Human-friendly wordmarks for the placeholder client keys.
const wordmarks: Record<string, string> = {
  am: 'AM',
  aa: 'Agua de Quito',
  sura: 'SURA',
  uno: 'UNO',
  claro: 'Claro',
};
const items = clients.map((key) => ({ key, label: wordmarks[key] ?? key.toUpperCase() }));
// Duplicated track so the marquee can loop seamlessly.
const track = [...items, ...items];
---

<section class="clients section" aria-label="Clientes que confían en nosotros">
  <div class="container">
    <p class="clients__label">Confían en nosotros</p>

    <div class="clients__marquee" role="list">
      <ul class="clients__track" aria-hidden="false">
        {track.map((item, i) => (
          <li class="clients__item" role="listitem" aria-hidden={i >= items.length ? 'true' : 'false'}>
            <span class="clients__wordmark">{item.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .clients {
    padding-block: clamp(2.5rem, 6vw, 4rem);
    border-block: 1px solid var(--line);
  }

  .clients__label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--muted-2);
    text-align: center;
    margin-bottom: 1.75rem;
  }

  .clients__marquee {
    position: relative;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  .clients__track {
    display: flex;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
    width: max-content;
    animation: clients-scroll 32s linear infinite;
    will-change: transform;
  }

  .clients__item { flex: none; }

  .clients__wordmark {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.35rem;
    letter-spacing: 0.02em;
    color: var(--muted-2);
    opacity: 0.65;
    transition: color 0.3s var(--ease), opacity 0.3s var(--ease);
    white-space: nowrap;
  }
  .clients__item:hover .clients__wordmark { color: var(--muted); opacity: 1; }

  @keyframes clients-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* Reduced motion: stop the marquee, center a static, non-duplicated row. */
  @media (prefers-reduced-motion: reduce) {
    .clients__marquee { -webkit-mask-image: none; mask-image: none; }
    .clients__track {
      animation: none;
      width: 100%;
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 1.25rem;
    }
    .clients__item[aria-hidden='true'] { display: none; }
  }
</style>
