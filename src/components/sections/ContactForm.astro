---
// ContactForm — CRM-agnostic lead capture.
// Posts to the Vercel serverless function at /api/lead (see /api/lead.js).
// Progressive enhancement: works as a plain HTML form if JS is disabled;
// with JS it submits via fetch (JSON) and shows an inline success message.
import Reveal from '../Reveal.astro';
---

<section class="contact-form section below-fold" id="contacto" aria-labelledby="contact-form-title">
  <div class="container form__grid">
    <Reveal class="form__intro">
      <p class="eyebrow">Contacto</p>
      <h2 id="contact-form-title" class="h2">
        El siguiente paso en la <span class="gradient-text">transformación</span> de tu empresa comienza aquí.
      </h2>
      <p class="muted form__lead">
        Convierte tus desafíos tecnológicos en oportunidades de crecimiento con un equipo
        que combina estrategia, innovación y excelencia técnica. Cuéntanos tu desafío y
        te respondemos a la brevedad.
      </p>
    </Reveal>

    <Reveal class="form__wrap" delay={1}>
      <form
        class="card lead-form"
        id="lead-form"
        method="post"
        action="/api/lead"
        novalidate
      >
        <div class="field">
          <label for="lf-nombre">Nombre<span aria-hidden="true"> *</span></label>
          <input
            type="text"
            id="lf-nombre"
            name="nombre"
            autocomplete="name"
            required
            aria-required="true"
          />
        </div>

        <div class="field">
          <label for="lf-email">Email<span aria-hidden="true"> *</span></label>
          <input
            type="email"
            id="lf-email"
            name="email"
            autocomplete="email"
            required
            aria-required="true"
          />
        </div>

        <div class="field">
          <label for="lf-empresa">Empresa<span aria-hidden="true"> *</span></label>
          <input
            type="text"
            id="lf-empresa"
            name="empresa"
            autocomplete="organization"
            required
            aria-required="true"
          />
        </div>

        <div class="field">
          <label for="lf-mensaje">Mensaje<span aria-hidden="true"> *</span></label>
          <textarea
            id="lf-mensaje"
            name="mensaje"
            rows="4"
            required
            aria-required="true"
          ></textarea>
        </div>

        <!-- Honeypot: hidden from humans, catches bots. Real users leave it empty. -->
        <div class="hp" aria-hidden="true">
          <label for="lf-website">No completar este campo</label>
          <input
            type="text"
            id="lf-website"
            name="website"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <button type="submit" class="btn btn--primary lead-form__submit">
          Solicite una asesoría sin costo
          <svg class="btn__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <!-- Live region: JS writes success/error feedback here. -->
        <p class="form__status" id="lead-status" role="status" aria-live="polite" hidden></p>
      </form>
    </Reveal>
  </div>
</section>

<style>
  .form__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .form__intro .h2 { margin-top: 0.75rem; }
  .form__lead { margin-top: 1.25rem; max-width: 46ch; }

  .lead-form { padding: clamp(1.5rem, 3vw, 2.5rem); display: grid; gap: 1.25rem; }
  /* Cancel the .card hover-lift on the form itself — a form isn't a link target. */
  .lead-form:hover { transform: none; border-color: var(--line); box-shadow: none; }

  .field { display: grid; gap: 0.5rem; }
  .field label {
    font-family: var(--font-mono);
    font-size: var(--fs-eyebrow);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
  }
  .field label span { color: var(--brand-400); }

  .field input,
  .field textarea {
    width: 100%;
    background: var(--ink);
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    padding: 0.8em 1em;
    color: var(--paper);
    font-size: 1rem;
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .field input::placeholder,
  .field textarea::placeholder { color: var(--muted-2); }
  .field textarea { resize: vertical; min-height: 120px; }

  .field input:hover,
  .field textarea:hover { border-color: var(--brand-400); }
  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: none;
    border-color: var(--brand-400);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand-400) 30%, transparent);
  }
  /* Invalid state only after the user has interacted (JS toggles aria-invalid). */
  .field input[aria-invalid="true"],
  .field textarea[aria-invalid="true"] {
    border-color: #ff6b6b;
    box-shadow: 0 0 0 3px rgba(255, 107, 107, 0.22);
  }

  /* Honeypot — visually and semantically removed from the flow. */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .lead-form__submit { justify-content: center; margin-top: 0.25rem; }

  .form__status {
    margin: 0;
    padding: 0.85em 1em;
    border-radius: 10px;
    font-size: 0.95rem;
    border: 1px solid var(--line);
  }
  .form__status[data-state="ok"] {
    color: var(--accent-cyan);
    border-color: color-mix(in srgb, var(--accent-cyan) 40%, transparent);
    background: color-mix(in srgb, var(--accent-cyan) 8%, transparent);
  }
  .form__status[data-state="error"] {
    color: #ff8f8f;
    border-color: rgba(255, 107, 107, 0.4);
    background: rgba(255, 107, 107, 0.08);
  }

  @media (max-width: 860px) {
    .form__grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Progressive enhancement: intercept submit, POST as JSON, show inline feedback.
  // If this script never runs (JS off), the form performs a normal POST to /api/lead.
  const form = document.getElementById('lead-form') as HTMLFormElement | null;
  const status = document.getElementById('lead-status') as HTMLParagraphElement | null;

  if (form && status) {
    const setStatus = (state: 'ok' | 'error', message: string) => {
      status.hidden = false;
      status.dataset.state = state;
      status.textContent = message;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Native validation first (keeps accessible error hints).
      const fields = ['nombre', 'email', 'empresa', 'mensaje'];
      let firstInvalid: HTMLElement | null = null;
      for (const name of fields) {
        const el = form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null;
        if (!el) continue;
        const valid = el.checkValidity();
        el.setAttribute('aria-invalid', String(!valid));
        if (!valid && !firstInvalid) firstInvalid = el;
      }
      if (firstInvalid) {
        setStatus('error', 'Revisa los campos marcados: completa todos los datos con un email válido.');
        firstInvalid.focus();
        return;
      }

      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (submitBtn) submitBtn.disabled = true;

      const data = Object.fromEntries(new FormData(form).entries());

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });

        if (res.ok) {
          form.reset();
          setStatus('ok', '¡Gracias! Recibimos tu mensaje. Te contactaremos a la brevedad.');
        } else {
          setStatus('error', 'No pudimos enviar tu mensaje. Inténtalo de nuevo en unos minutos.');
          if (submitBtn) submitBtn.disabled = false;
        }
      } catch {
        setStatus('error', 'Hubo un problema de conexión. Revisa tu red e inténtalo otra vez.');
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }
</script>
