---
// Services section — #servicios. Grid of 6 service cards.
// The brand images are landscape photographs (391x224), shown as card banners.
import { Image } from 'astro:assets';
import { services } from '../../data/site';
import Reveal from '../Reveal.astro';

const iconModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/home/services/*.png',
  { eager: true }
);
const imgFor = (file: string) =>
  iconModules[`../../assets/home/services/${file}`]?.default;
---

<section id="servicios" class="section below-fold">
  <div class="container">
    <Reveal class="services__head">
      <p class="eyebrow eyebrow--icon">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 9V5a2 2 0 0 1 2-2h4"/><path d="M2 15v4a2 2 0 0 0 2 2h4"/><path d="M22 9V5a2 2 0 0 0-2-2h-4"/><path d="M22 15v4a2 2 0 0 1-2 2h-4"/><rect x="8" y="8" width="8" height="8" rx="1"/></svg>
        Servicios
      </p>
      <h2 class="h2 services__title">
        Expertos en <span class="gradient-text">cada capa</span> de tu nube
      </h2>
    </Reveal>

    <ul class="services__grid" role="list">
      {services.map((service, i) => (
        <Reveal as="li" delay={(i % 5) as 0 | 1 | 2 | 3 | 4}>
          <a class="card svc" href={`/servicio/${service.slug}`}>
            <span class="svc__media">
              <Image
                src={imgFor(service.img)!}
                alt={service.title}
                widths={[300, 400, 520]}
                sizes="(max-width: 560px) 100vw, (max-width: 900px) 50vw, 360px"
                class="svc__img"
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="svc__body">
              <h3 class="h3 svc__title-c">{service.title}</h3>
              <p class="muted svc__desc">{service.desc}</p>
              <span class="svc__cta">
                Ver servicio
                <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </span>
          </a>
        </Reveal>
      ))}
    </ul>
  </div>
</section>

<style>
  .services__head { max-width: 34ch; margin-bottom: var(--stack-block); }
  .services__title {
    font-family: var(--font-display);
    font-weight: 700; line-height: 1.05; letter-spacing: -0.02em; margin-top: var(--stack-xs);
  }
  .services__grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: var(--gap-grid); list-style: none; margin: 0; padding: 0;
  }
  .svc {
    position: relative; display: flex; flex-direction: column; height: 100%;
    overflow: hidden;
  }
  .svc__media {
    display: block; aspect-ratio: 16 / 10; overflow: hidden;
    border-bottom: 1px solid var(--line); background: var(--ink-3);
  }
  .svc__img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.5s var(--ease);
  }
  .svc:hover .svc__img { transform: scale(1.05); }
  .svc__body {
    display: flex; flex-direction: column;
    padding: clamp(1.5rem, 2.5vw, 1.9rem);
    flex: 1;
  }
  .svc__title-c {
    font-family: var(--font-display); font-weight: 500; letter-spacing: -0.01em;
    margin: 0 0 0.75rem; color: var(--paper); font-size: 1.2rem;
  }
  .svc__desc { font-family: var(--font-body); line-height: 1.65; margin: 0; font-size: 0.95rem; }
  .svc__cta {
    margin-top: 1.5rem; display: inline-flex; align-items: center; gap: 0.45rem;
    font-family: var(--font-body); font-weight: 600; font-size: 0.9rem; color: var(--brand-400);
  }
  .svc__cta svg { transition: transform 0.25s var(--ease); }
  .svc:hover .svc__cta svg { transform: translateX(4px); }

  @media (max-width: 900px) { .services__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .services__grid { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) {
    .svc__img, .svc__cta svg { transition: none; }
  }
</style>
