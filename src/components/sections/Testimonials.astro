---
// Testimonials — elegant, typography-forward quote cards.
import { testimonials } from '../../data/site';
import Reveal from '../Reveal.astro';
---

<section class="section testimonials below-fold" aria-labelledby="testimonials-title">
  <div class="container">
    <Reveal>
      <p class="eyebrow">Lo que dicen nuestros clientes</p>
      <h2 id="testimonials-title" class="h2 testimonials__title">
        Confianza construida proyecto a proyecto.
      </h2>
    </Reveal>

    <ul class="testimonials__grid" role="list">
      {testimonials.map((t, i) => (
        <Reveal as="li" delay={(i + 1) as 1 | 2 | 3} class="testimonials__item">
          <figure class="card quote">
            <span class="quote__mark" aria-hidden="true">&ldquo;</span>
            <blockquote class="quote__body">
              <p>{t.quote}</p>
            </blockquote>
            <figcaption class="quote__cite">
              <span class="quote__name">{t.name}</span>
              <span class="quote__role">{t.role}</span>
            </figcaption>
          </figure>
        </Reveal>
      ))}
    </ul>
  </div>
</section>

<style>
  .testimonials__title {
    max-width: 20ch;
    margin-top: 0.75rem;
  }

  .testimonials__grid {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(3, 1fr);
  }

  .testimonials__item {
    display: flex;
  }

  .quote {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 2rem 1.75rem 1.75rem;
    isolation: isolate;
  }

  /* --brand accent bar on the leading edge */
  .quote::before {
    content: "";
    position: absolute;
    inset: 1.75rem auto 1.75rem 0;
    width: 3px;
    border-radius: 999px;
    background: var(--grad-flow);
    opacity: 0.55;
    transition: opacity 0.3s var(--ease);
  }
  .quote:hover::before { opacity: 1; }

  .quote__mark {
    font-family: var(--font-display);
    font-size: 4.5rem;
    line-height: 0.7;
    color: var(--brand-400);
    opacity: 0.28;
    margin-bottom: 0.25rem;
    user-select: none;
  }

  .quote__body p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--paper);
    max-width: 46ch;
  }

  .quote__cite {
    margin-top: auto;
    padding-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-style: normal;
  }

  .quote__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.0625rem;
    color: var(--paper);
    letter-spacing: -0.01em;
  }

  .quote__role {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .testimonials__grid { grid-template-columns: 1fr; max-width: 42rem; }
  }
</style>
