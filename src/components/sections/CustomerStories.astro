---
// Customer Stories — responsive card grid of case studies.
import { stories } from '../../data/site';
import Reveal from '../Reveal.astro';
---

<section id="casos" class="section stories below-fold" aria-labelledby="stories-title">
  <div class="container">
    <Reveal>
      <p class="eyebrow">Customer Stories</p>
      <h2 id="stories-title" class="h2 stories__title">
        Casos de éxito que hablan por nosotros.
      </h2>
    </Reveal>

    <ul class="stories__grid" role="list">
      {stories.map((s, i) => (
        <Reveal as="li" delay={((i % 3) + 1) as 1 | 2 | 3} class="stories__item">
          <a class="card story" href={s.href}>
            <span class="story__accent" aria-hidden="true"></span>
            <span class="story__tag">{s.tag}</span>
            <h3 class="h3 story__title">{s.title}</h3>
            <span class="story__more">
              Leer más
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        </Reveal>
      ))}
    </ul>
  </div>
</section>

<style>
  .stories__title {
    max-width: 18ch;
    margin-top: 0.75rem;
  }

  .stories__grid {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(3, 1fr);
  }

  .stories__item { display: flex; }

  .story {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem;
    overflow: hidden;
    height: 100%;
  }

  /* gradient top-border revealed on hover */
  .story__accent {
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: var(--grad-flow);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease);
  }
  .story:hover .story__accent,
  .story:focus-visible .story__accent { transform: scaleX(1); }

  .story__tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--brand-400);
    padding: 0.35em 0.75em;
    border: 1px solid var(--line);
    border-radius: 999px;
    align-self: flex-start;
  }

  .story__title {
    color: var(--paper);
    letter-spacing: -0.015em;
    line-height: 1.25;
  }

  .story__more {
    margin-top: auto;
    padding-top: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--brand-400);
  }
  .story__more svg { transition: transform 0.25s var(--ease); }
  .story:hover .story__more svg,
  .story:focus-visible .story__more svg { transform: translateX(4px); }

  @media (max-width: 960px) {
    .stories__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 620px) {
    .stories__grid { grid-template-columns: 1fr; }
  }
</style>
