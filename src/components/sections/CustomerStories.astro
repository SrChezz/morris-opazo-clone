---
// Customer Stories — compact strip of real case studies with cover images.
// Shows the 3 most representative; full grid lives on /casos.
import { Image } from 'astro:assets';
import { stories } from '../../data/site';
import Reveal from '../Reveal.astro';

const covers = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/home/stories/*.jpg',
  { eager: true }
);
const coverFor = (file: string) =>
  covers[`../../assets/home/stories/${file.replace(/\.[a-z]+$/, '')}.jpg`]?.default
  ?? covers[`../../assets/home/stories/${file}`]?.default;

// Compact: feature the first three on the home.
const featured = stories.slice(0, 3);
---

<section id="casos" class="section stories below-fold" aria-labelledby="stories-title">
  <div class="container">
    <Reveal class="stories__head">
      <div>
        <p class="eyebrow eyebrow--icon">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
          Customer Stories
        </p>
        <h2 id="stories-title" class="h2 stories__title">
          Casos de éxito que hablan por nosotros.
        </h2>
      </div>
      <a href="/casos" class="stories__all">
        Ver todos los casos
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </Reveal>

    <ul class="stories__grid" role="list">
      {featured.map((s, i) => (
        <Reveal as="li" delay={((i % 3) + 1) as 1 | 2 | 3} class="stories__item">
          <a class="card story" href={s.href}>
            <span class="story__media">
              <Image
                src={coverFor(s.cover)!}
                alt={s.title}
                widths={[400, 600, 800]}
                sizes="(max-width: 620px) 100vw, (max-width: 960px) 50vw, 380px"
                class="story__img"
                loading="lazy"
                decoding="async"
              />
              <span class="story__tag">{s.tag}</span>
            </span>
            <span class="story__body">
              <h3 class="h3 story__title-c">{s.title}</h3>
              <span class="story__more">
                Leer más
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </span>
          </a>
        </Reveal>
      ))}
    </ul>
  </div>
</section>

<style>
  .stories__head {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: 1.5rem; flex-wrap: wrap;
  }
  .stories__title { max-width: 18ch; margin-top: 0.75rem; }
  .stories__all {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-body); font-weight: 600; font-size: 0.95rem;
    color: var(--brand-400); white-space: nowrap;
  }
  .stories__all svg { transition: transform 0.25s var(--ease); }
  .stories__all:hover svg { transform: translateX(4px); }

  .stories__grid {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: grid; gap: 1.5rem; grid-template-columns: repeat(3, 1fr);
    list-style: none; padding: 0;
  }
  .stories__item { display: flex; }
  .story {
    position: relative; display: flex; flex-direction: column;
    overflow: hidden; height: 100%;
  }
  .story__media {
    position: relative; display: block; aspect-ratio: 16 / 9;
    overflow: hidden; border-bottom: 1px solid var(--line); background: var(--ink-3);
  }
  .story__img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.5s var(--ease);
  }
  .story:hover .story__img { transform: scale(1.04); }
  .story__tag {
    position: absolute; top: 0.85rem; left: 0.85rem;
    font-family: var(--font-mono); font-size: 0.68rem; text-transform: uppercase;
    letter-spacing: 0.1em; color: var(--paper);
    padding: 0.3em 0.7em; border-radius: 999px;
    background: color-mix(in srgb, var(--ink) 70%, transparent);
    backdrop-filter: blur(6px); border: 1px solid var(--line-strong);
  }
  .story__body {
    display: flex; flex-direction: column; gap: 1.1rem;
    padding: 1.75rem 1.6rem; flex: 1;
  }
  .story__title-c { color: var(--paper); letter-spacing: -0.015em; line-height: 1.25; font-size: 1.1rem; }
  .story__more {
    margin-top: auto; display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-body); font-weight: 600; font-size: 0.95rem; color: var(--brand-400);
  }
  .story__more svg { transition: transform 0.25s var(--ease); }
  .story:hover .story__more svg { transform: translateX(4px); }

  @media (max-width: 960px) { .stories__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) { .stories__grid { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) {
    .story__img, .story__more svg, .stories__all svg { transition: none; }
  }
</style>
