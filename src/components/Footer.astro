---
import { site, services, industries } from '../data/site';
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <div class="brand">
          <svg width="30" height="30" viewBox="0 0 64 64" aria-hidden="true">
            <defs><linearGradient id="fg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#605BE5"/><stop offset="0.5" stop-color="#8B7CFF"/><stop offset="1" stop-color="#38E8D8"/></linearGradient></defs>
            <path d="M14 44V20l9 12 9-12v24" fill="none" stroke="url(#fg)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="46" cy="24" r="5" fill="url(#fg)"/>
          </svg>
          <span>Morris <span style="color:var(--brand-400)">&amp;</span> Opazo</span>
        </div>
        <p class="footer__desc muted">{site.descriptor}</p>
        <div class="footer__social">
          <a href={site.social.linkedin} aria-label="LinkedIn" target="_blank" rel="noopener">Linkedin</a>
          <a href={site.social.instagram} aria-label="Instagram" target="_blank" rel="noopener">Instagram</a>
          <a href={site.social.youtube} aria-label="YouTube" target="_blank" rel="noopener">Youtube</a>
        </div>
      </div>

      <nav class="footer__col" aria-label="Soluciones">
        <h3 class="eyebrow">Soluciones</h3>
        <ul>{services.map((s) => <li><a href="#servicios">{s.title}</a></li>)}</ul>
      </nav>

      <nav class="footer__col" aria-label="Industrias">
        <h3 class="eyebrow">Industrias</h3>
        <ul>{industries.map((i) => <li><a href="#industrias">{i}</a></li>)}</ul>
      </nav>

      <nav class="footer__col" aria-label="Compañía">
        <h3 class="eyebrow">Compañía</h3>
        <ul>
          <li><a href="/nosotros">Nosotros</a></li>
          <li><a href="#casos">Casos de éxito</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/startup">Startup</a></li>
          <li><a href="/talento">Talento</a></li>
          <li><a href="#contacto">Contacto</a></li>
        </ul>
      </nav>
    </div>

    <div class="footer__bottom">
      <span class="footer__legal">{site.legal}</span>
      <span class="footer__partner">PARTNER OFICIAL <strong>AWS</strong></span>
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); padding-block: clamp(3.5rem, 7vw, 6rem) 2rem; background: var(--ink-2); }
  .footer__top { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 2.5rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.55rem; font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; }
  .footer__desc { margin-top: 1rem; max-width: 34ch; font-size: 0.95rem; }
  .footer__social { display: flex; gap: 1rem; margin-top: 1.5rem; }
  .footer__social a { font-size: 0.9rem; color: var(--muted); transition: color 0.2s var(--ease); }
  .footer__social a:hover { color: var(--brand-400); }

  .footer__col h3 { margin-bottom: 1rem; }
  .footer__col ul { display: grid; gap: 0.55rem; }
  .footer__col a { font-size: 0.925rem; color: var(--muted); transition: color 0.2s var(--ease); }
  .footer__col a:hover { color: var(--paper); }

  .footer__bottom { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: 3.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .footer__legal { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.08em; color: var(--muted-2); }
  .footer__partner { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.12em; color: var(--muted); }
  .footer__partner strong { color: var(--brand-400); }

  @media (max-width: 860px) {
    .footer__top { grid-template-columns: 1fr 1fr; }
    .footer__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) { .footer__top { grid-template-columns: 1fr; } }
</style>
