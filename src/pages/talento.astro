---
// /talento — talent page. Reuses BaseLayout + Header + Footer + Button + Reveal
// and design tokens from global.css. Zero client JS frameworks.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import Reveal from '../components/Reveal.astro';

const capabilities = [
  {
    title: 'Formamos',
    desc: 'Programas de formación intensivos en arquitectura de nube, datos e IA, diseñados junto a AWS re/Start.',
  },
  {
    title: 'Certificamos',
    desc: 'Preparamos y certificamos profesionales bajo los estándares AWS para que lleguen listos a producción.',
  },
  {
    title: 'Conectamos',
    desc: 'Vinculamos el talento técnico con los proyectos de TI que necesitan agilidad, escalabilidad y excelencia operativa.',
  },
];

const areas = [
  { title: 'Arquitectura de nube', desc: 'Especialistas en diseño e implementación de soluciones escalables sobre AWS.' },
  { title: 'Datos & Analítica', desc: 'Ingeniería de datos y analítica avanzada para decisiones basadas en evidencia.' },
  { title: 'Inteligencia Artificial', desc: 'Machine Learning y Gen AI aplicados a desafíos reales de negocio.' },
];
---

<BaseLayout
  title="Talento — Morris & Opazo"
  description="Potenciamos el talento técnico que impulsa la nube. Formamos, certificamos y conectamos profesionales en arquitectura de nube, datos e IA para acelerar tus proyectos de TI."
>
  <Header />
  <main id="content">
    <!-- Hero -->
    <section class="section hero">
      <div class="container">
        <Reveal class="hero__inner">
          <p class="eyebrow">Talento</p>
          <h1 class="hero__title">
            Potenciamos el <span class="gradient-text">talento</span> técnico que impulsa la nube
          </h1>
          <p class="hero__lead muted">
            Formamos, certificamos y conectamos profesionales en arquitectura de nube, datos e IA
            para acelerar tus proyectos de TI con agilidad, escalabilidad y excelencia operativa.
          </p>
          <div class="hero__cta">
            <Button href="/#contacto" variant="primary">Solicite una asesoría sin costo</Button>
          </div>
        </Reveal>
      </div>
    </section>

    <!-- Capabilities -->
    <section class="section below-fold points">
      <div class="container">
        <Reveal class="points__head">
          <p class="eyebrow">Cómo lo hacemos</p>
          <h2 class="h2">Formamos, certificamos y conectamos</h2>
        </Reveal>
        <ul class="points__grid" role="list">
          {
            capabilities.map((c, i) => (
              <Reveal as="li" delay={(i % 5) as 0 | 1 | 2 | 3 | 4}>
                <article class="card point">
                  <h3 class="h3 point__title">{c.title}</h3>
                  <p class="muted point__desc">{c.desc}</p>
                  <span class="point__line" aria-hidden="true" />
                </article>
              </Reveal>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Alliance banner -->
    <section class="section below-fold alliance">
      <div class="container">
        <Reveal class="card alliance__card">
          <p class="eyebrow">Alianza</p>
          <h2 class="h2 alliance__title">
            <span class="gradient-text">AWS re/Start</span> + Morris &amp; Opazo
          </h2>
          <p class="alliance__lead muted">
            Una alianza que abre la puerta a nuevas carreras en la nube: talento formado con los
            estándares de AWS y listo para acelerar los proyectos más exigentes de la región.
          </p>
          <Button href="/#contacto" variant="ghost">Contrata ahora</Button>
        </Reveal>
      </div>
    </section>

    <!-- Areas -->
    <section class="section below-fold areas">
      <div class="container">
        <Reveal class="areas__head">
          <p class="eyebrow">Áreas de especialización</p>
          <h2 class="h2">Perfiles listos para producción</h2>
        </Reveal>
        <ul class="areas__grid" role="list">
          {
            areas.map((a, i) => (
              <Reveal as="li" delay={(i % 5) as 0 | 1 | 2 | 3 | 4}>
                <article class="card point">
                  <h3 class="h3 point__title">{a.title}</h3>
                  <p class="muted point__desc">{a.desc}</p>
                  <span class="point__line" aria-hidden="true" />
                </article>
              </Reveal>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Closing CTA -->
    <section class="section below-fold cta">
      <div class="container">
        <Reveal class="card cta__card">
          <p class="eyebrow">Conversemos</p>
          <h2 class="h2 cta__title">
            Acelera tus proyectos con el <span class="gradient-text">talento</span> correcto
          </h2>
          <p class="cta__lead muted">
            Convierte tus desafíos tecnológicos en oportunidades de crecimiento con un equipo que
            combina estrategia, innovación y excelencia técnica.
          </p>
          <Button href="/#contacto" variant="primary">Solicite una asesoría sin costo</Button>
        </Reveal>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* Hero */
  .hero { padding-block: clamp(6rem, 12vw, 10rem) clamp(3rem, 6vw, 5rem); }
  .hero__inner { max-width: 60ch; }
  .hero__title {
    font-size: var(--fs-display);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin-top: 1rem;
  }
  .hero__lead { max-width: 62ch; margin-top: 1.5rem; font-size: var(--fs-h3); font-family: var(--font-body); }
  .hero__cta { margin-top: 2.5rem; }

  /* Points / Areas (shared card layout) */
  .points__head,
  .areas__head { max-width: 42ch; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .points__head .h2,
  .areas__head .h2 { margin-top: 0.75rem; }
  .points__grid,
  .areas__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
    margin: 0;
    padding: 0;
  }
  .point {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(1.5rem, 2.5vw, 2rem);
    overflow: hidden;
  }
  .point__title { font-weight: 500; letter-spacing: -0.01em; margin: 0 0 0.6rem; }
  .point__desc { margin: 0; line-height: 1.6; }
  .point__line { margin-top: auto; padding-top: 1.5rem; display: block; height: 2px; width: 100%; }
  .point__line::after {
    content: '';
    display: block;
    height: 2px;
    border-radius: 2px;
    background: var(--grad-flow);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease);
  }
  .point:hover .point__line::after { transform: scaleX(1); }

  /* Alliance */
  .alliance__card {
    text-align: center;
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 5vw, 4rem);
    background: var(--ink-2);
    background-image: var(--grad-soft);
  }
  .alliance__title { margin: 0.75rem auto 1.25rem; max-width: 22ch; }
  .alliance__lead { max-width: 58ch; margin: 0 auto 2rem; }

  /* Closing CTA */
  .cta__card {
    text-align: center;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem);
    background: var(--ink-2);
    background-image: var(--grad-soft);
  }
  .cta__title { margin: 0.75rem auto 1.25rem; max-width: 24ch; }
  .cta__lead { max-width: 60ch; margin: 0 auto 2rem; }

  @media (max-width: 900px) {
    .points__grid,
    .areas__grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .point__line::after { transition: none; transform: scaleX(1); }
  }
</style>
