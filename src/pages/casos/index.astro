---
// Casos de éxito — listado estático generado desde la colección de contenido.
// Approach B: portadas optimizadas con <Image /> de astro:assets.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Reveal from '../../components/Reveal.astro';

// Solo publicados, ordenados de más reciente a más antiguo.
const casos = (await getCollection('casos', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Casos de éxito — Morris & Opazo"
  description="Historias reales de transformación cloud sobre AWS: migraciones del sector público, IoT, salud, IA y analítica avanzada. El partner que entiende tu industria."
>
  <Header />
  <main id="content">
    <section class="section casos" aria-labelledby="casos-title">
      <div class="container">
        <Reveal>
          <p class="eyebrow">Customer Stories</p>
          <h1 class="h2 casos__title" id="casos-title">
            Historias que <span class="gradient-text">transforman</span> industrias.
          </h1>
          <p class="muted casos__lead">
            Proyectos reales donde convertimos desafíos tecnológicos en resultados de
            negocio, junto a nuestros clientes y AWS.
          </p>
        </Reveal>

        <ul class="casos__grid" role="list">
          {casos.map((caso, i) => (
            <Reveal as="li" delay={((i % 3) + 1) as 1 | 2 | 3} class="casos__item">
              <a class="card caso" href={`/casos/${caso.slug}/`}>
                <span class="caso__accent" aria-hidden="true"></span>
                <div class="caso__media">
                  <Image
                    src={caso.data.cover}
                    alt={caso.data.coverAlt}
                    widths={[400, 600, 800]}
                    sizes="(max-width: 620px) 100vw, (max-width: 960px) 50vw, 380px"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    class="caso__img"
                  />
                </div>
                <div class="caso__body">
                  <div class="caso__meta">
                    <span class="caso__tag">{caso.data.industry}</span>
                    {caso.data.client && (
                      <span class="caso__client">{caso.data.client}</span>
                    )}
                  </div>
                  <h2 class="h3 caso__heading">{caso.data.title}</h2>
                  <p class="muted caso__desc">{caso.data.description}</p>
                  <span class="caso__more">
                    Leer más
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </div>
              </a>
            </Reveal>
          ))}
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .casos__title { max-width: 18ch; margin-top: 0.75rem; }
  .casos__lead { max-width: 52ch; margin-top: 1rem; font-size: var(--fs-body); }

  .casos__grid {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(3, 1fr);
  }
  .casos__item { display: flex; }

  .caso {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
  }

  /* gradiente superior revelado en hover (mismo lenguaje que Customer Stories) */
  .caso__accent {
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: var(--grad-flow);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease);
    z-index: 1;
  }
  .caso:hover .caso__accent,
  .caso:focus-visible .caso__accent { transform: scaleX(1); }

  .caso__media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: var(--ink-3);
  }
  .caso__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }
  .caso:hover .caso__img { transform: scale(1.04); }

  .caso__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    flex: 1;
  }

  .caso__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .caso__tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--brand-400);
    padding: 0.3em 0.7em;
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .caso__client {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--muted-2);
  }

  .caso__heading { color: var(--paper); letter-spacing: -0.015em; line-height: 1.25; }
  .caso__desc { font-size: 0.95rem; line-height: 1.6; }

  .caso__more {
    margin-top: auto;
    padding-top: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--brand-400);
  }
  .caso__more svg { transition: transform 0.25s var(--ease); }
  .caso:hover .caso__more svg,
  .caso:focus-visible .caso__more svg { transform: translateX(4px); }

  @media (max-width: 960px) {
    .casos__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 620px) {
    .casos__grid { grid-template-columns: 1fr; }
  }
</style>
