---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';
import Reveal from '../../components/Reveal.astro';

const challenges = [
  { title: 'Datos clínicos dispersos', desc: 'Unifique historiales y sistemas en una plataforma gobernada, segura y trazable.' },
  { title: 'Cumplimiento normativo', desc: 'Proteja datos sensibles de pacientes con controles de privacidad y auditoría.' },
  { title: 'Optimización de costos', desc: 'Escale la infraestructura según demanda y libere presupuesto para innovar.' },
  { title: 'Continuidad asistencial', desc: 'Sostenga sistemas críticos con alta disponibilidad y recuperación ante fallas.' },
];

const soluciones = [
  { title: 'Gobierno de datos', desc: 'Plataformas seguras para gestionar información clínica con cumplimiento normativo.' },
  { title: 'IA para diagnóstico', desc: 'Modelos que apoyan la investigación y aceleran el análisis biomédico en AWS.' },
  { title: 'Interoperabilidad', desc: 'Integración de sistemas clínicos para una vista única y confiable del paciente.' },
];
---

<BaseLayout
  title="Healthcare — Morris & Opazo"
  description="Gobierne sus datos clínicos con AWS: seguridad, cumplimiento normativo e innovación para el sector salud en Latinoamérica."
>
  <Header />
  <main id="content">
    <section class="hero container">
      <Reveal as="p" class="eyebrow">Healthcare</Reveal>
      <Reveal as="h1" class="hero__title" delay={1}>
        Gobierne sus <span class="gradient-text">datos clínicos</span> de forma eficiente
      </Reveal>
      <Reveal as="p" class="hero__lead muted" delay={2}>
        El sector salud en LATAM enfrenta una fuerte presión por optimizar costos e innovar.
        Transforme su gestión de riesgos y sistemas clínicos con seguridad y cumplimiento
        normativo en la nube.
      </Reveal>
      <Reveal class="hero__cta" delay={3}>
        <Button href="/#contacto">Solicite una asesoría sin costo</Button>
      </Reveal>
    </section>

    <section class="section below-fold container">
      <Reveal as="p" class="eyebrow">Desafíos del sector</Reveal>
      <Reveal as="h2" class="h2 block__title" delay={1}>Los retos que resolvemos con usted</Reveal>
      <ul class="grid grid--2" role="list">
        {challenges.map((c, i) => (
          <Reveal as="li" class="card cell" delay={(i % 2) as 0 | 1}>
            <h3 class="h3">{c.title}</h3>
            <p class="muted">{c.desc}</p>
          </Reveal>
        ))}
      </ul>
    </section>

    <section class="section below-fold container">
      <Reveal as="p" class="eyebrow">Soluciones</Reveal>
      <Reveal as="h2" class="h2 block__title" delay={1}>Cómo lo hacemos sobre AWS</Reveal>
      <ul class="grid grid--3" role="list">
        {soluciones.map((s, i) => (
          <Reveal as="li" class="card cell" delay={(i % 3) as 0 | 1 | 2}>
            <h3 class="h3">{s.title}</h3>
            <p class="muted">{s.desc}</p>
          </Reveal>
        ))}
      </ul>
    </section>

    <section class="section below-fold container">
      <Reveal class="card teaser">
        <div>
          <p class="eyebrow">Customer stories</p>
          <h2 class="h3 teaser__title">Más pacientes, mejor atención</h2>
          <p class="muted teaser__desc">
            Desde la transformación digital de la atención hasta la investigación
            biotecnológica con IA: conozca cómo la salud avanza con Morris &amp; Opazo y AWS.
          </p>
        </div>
        <Button href="/casos" variant="ghost">Ver casos de éxito</Button>
      </Reveal>
    </section>

    <section class="section below-fold container">
      <Reveal class="cta">
        <h2 class="h2 cta__title">El siguiente paso comienza aquí.</h2>
        <p class="muted cta__desc">
          Convierte tus desafíos tecnológicos en oportunidades de crecimiento con un equipo
          que combina estrategia, innovación y excelencia técnica.
        </p>
        <Button href="/#contacto">Solicite una asesoría sin costo</Button>
      </Reveal>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .hero { padding-block: clamp(4rem, 9vw, 7rem) clamp(2rem, 4vw, 3rem); max-width: 900px; }
  .hero__title { font-size: var(--fs-display); letter-spacing: -0.03em; margin-top: 1.25rem; }
  .hero__lead { margin-top: 1.5rem; max-width: 62ch; }
  .hero__cta { margin-top: 2.25rem; }

  .block__title { margin-top: 1rem; margin-bottom: 2.5rem; max-width: 20ch; }

  .grid { display: grid; gap: 1.25rem; }
  .grid--2 { grid-template-columns: repeat(2, 1fr); }
  .grid--3 { grid-template-columns: repeat(3, 1fr); }
  .cell { padding: 1.75rem; display: flex; flex-direction: column; gap: 0.6rem; }
  .cell h3 { color: var(--paper); }
  .cell p { font-size: 0.95rem; }

  .teaser {
    display: flex; align-items: center; justify-content: space-between;
    gap: 2rem; padding: clamp(1.75rem, 4vw, 2.75rem); flex-wrap: wrap;
  }
  .teaser__title { margin-top: 0.75rem; color: var(--paper); }
  .teaser__desc { margin-top: 0.75rem; max-width: 60ch; }

  .cta { text-align: center; max-width: 720px; margin-inline: auto; }
  .cta__title { max-width: 18ch; margin-inline: auto; }
  .cta__desc { margin: 1.25rem auto 2rem; max-width: 56ch; }

  @media (max-width: 860px) { .grid--2, .grid--3 { grid-template-columns: 1fr; } }
</style>
