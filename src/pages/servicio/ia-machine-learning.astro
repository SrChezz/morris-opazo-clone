---
// Servicio — AI & Machine Learning. Self-contained. Reusa layout/header/footer/reveal + tokens.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';
import Reveal from '../../components/Reveal.astro';

const expertise = [
  {
    title: 'Modelos a la medida',
    desc: 'Arquitecturas predictivas diseñadas alrededor de tus desafíos operativos, no plantillas genéricas.',
  },
  {
    title: 'De la estrategia a la producción',
    desc: 'Llevamos los modelos del laboratorio a producción con MLOps sobre Amazon SageMaker.',
  },
  {
    title: 'Decisiones en tiempo real',
    desc: 'Inferencia de baja latencia para automatizar decisiones críticas en el momento en que ocurren.',
  },
  {
    title: 'Impacto medible',
    desc: 'Definimos métricas de negocio desde el inicio para que cada modelo demuestre su valor.',
  },
];

const soluciones = [
  {
    title: 'Modelos predictivos',
    desc: 'Anticipa demanda, fallas o riesgo con modelos entrenados sobre tus datos históricos.',
  },
  {
    title: 'Detección y scoring de riesgo',
    desc: 'Identifica fraude, anomalías y patrones antes de que se conviertan en un problema.',
  },
  {
    title: 'MLOps en AWS',
    desc: 'Entrenamiento, despliegue y monitoreo automatizados para modelos siempre vigentes.',
  },
];
---

<BaseLayout
  title="AI & Machine Learning — Morris & Opazo | Partner AWS"
  description="Inteligencia Artificial que transforma industrias: arquitecturas predictivas y modelos a la medida, de la estrategia a la producción con impacto medible."
>
  <Header />
  <main id="content">
    <section class="section svc-hero" aria-labelledby="svc-title">
      <div class="container">
        <Reveal>
          <p class="eyebrow">AI &amp; Machine Learning</p>
          <h1 class="h2 svc-hero__title">
            Inteligencia Artificial que transforma
            <span class="gradient-text">industrias</span>
          </h1>
          <p class="muted svc-hero__lead">
            Evolucione su modelo de negocio mediante arquitecturas predictivas y modelos de
            IA diseñados a la medida de sus desafíos operativos. De la estrategia a la
            producción con impacto medible.
          </p>
          <div class="svc-hero__cta">
            <Button href="/#contacto">Solicite una asesoría sin costo</Button>
          </div>
        </Reveal>
      </div>
    </section>

    <section class="section below-fold" aria-labelledby="exp-title">
      <div class="container">
        <Reveal>
          <p class="eyebrow">Nuestra expertise</p>
          <h2 id="exp-title" class="h3 sec-title">Del modelo al impacto en el negocio.</h2>
        </Reveal>
        <ul class="grid grid--exp" role="list">
          {expertise.map((e, i) => (
            <Reveal as="li" delay={((i % 4) + 1) as 1 | 2 | 3 | 4} class="grid__item">
              <div class="card feat">
                <span class="feat__num">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="feat__title">{e.title}</h3>
                <p class="muted feat__desc">{e.desc}</p>
              </div>
            </Reveal>
          ))}
        </ul>
      </div>
    </section>

    <section class="section below-fold sec-alt" aria-labelledby="sol-title">
      <div class="container">
        <Reveal>
          <p class="eyebrow">Soluciones</p>
          <h2 id="sol-title" class="h3 sec-title">Lo que construimos contigo.</h2>
        </Reveal>
        <ul class="grid grid--sol" role="list">
          {soluciones.map((s, i) => (
            <Reveal as="li" delay={((i % 3) + 1) as 1 | 2 | 3} class="grid__item">
              <div class="card sol">
                <span class="sol__accent" aria-hidden="true"></span>
                <h3 class="feat__title">{s.title}</h3>
                <p class="muted feat__desc">{s.desc}</p>
              </div>
            </Reveal>
          ))}
        </ul>
      </div>
    </section>

    <section class="section below-fold" aria-labelledby="casos-title">
      <div class="container">
        <Reveal class="casos">
          <div class="casos__text">
            <p class="eyebrow">Casos de éxito</p>
            <h2 id="casos-title" class="h3 casos__title">
              Machine Learning para decidir en tiempo real.
            </h2>
            <p class="muted">
              Apoyamos iniciativas de ML e IA como la toma de decisiones en tiempo real, con
              gran efectividad. Conoce las historias.
            </p>
          </div>
          <a class="casos__link" href="/casos">
            Ver casos de éxito
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </Reveal>
      </div>
    </section>

    <section class="section below-fold svc-cta" aria-labelledby="cta-title">
      <div class="container">
        <Reveal class="svc-cta__inner">
          <p class="eyebrow">Da el siguiente paso</p>
          <h2 id="cta-title" class="h2 svc-cta__title">
            Pon la inteligencia artificial a decidir por tu
            <span class="gradient-text">negocio</span>.
          </h2>
          <p class="muted svc-cta__lead">
            Hablemos de tu próximo gran proyecto con un equipo que combina estrategia,
            innovación y excelencia técnica.
          </p>
          <Button href="/#contacto">Solicite una asesoría sin costo</Button>
        </Reveal>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .svc-hero { padding-bottom: clamp(2.5rem, 5vw, 4rem); position: relative; }
  .svc-hero::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: var(--grad-soft); pointer-events: none;
  }
  .svc-hero__title { max-width: 18ch; margin-top: 0.75rem; }
  .svc-hero__lead { max-width: 60ch; margin-top: 1.25rem; }
  .svc-hero__cta { margin-top: 2rem; }

  .sec-title { margin-top: 0.6rem; max-width: 30ch; }
  .sec-alt { background: var(--ink-2); border-block: 1px solid var(--line); }

  .grid { margin-top: clamp(2rem, 4vw, 3rem); display: grid; gap: 1.5rem; }
  .grid--exp { grid-template-columns: repeat(4, 1fr); }
  .grid--sol { grid-template-columns: repeat(3, 1fr); }
  .grid__item { display: flex; }

  .feat { padding: 1.5rem; display: flex; flex-direction: column; gap: 0.6rem; height: 100%; }
  .feat__num { font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.12em; color: var(--brand-400); }
  .feat__title { font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; letter-spacing: -0.015em; color: var(--paper); }
  .feat__desc { font-size: 0.925rem; line-height: 1.6; }

  .sol { position: relative; padding: 1.75rem; display: flex; flex-direction: column; gap: 0.6rem; height: 100%; overflow: hidden; }
  .sol__accent { position: absolute; inset: 0 0 auto 0; height: 2px; background: var(--grad-flow); transform: scaleX(0); transform-origin: left; transition: transform 0.4s var(--ease); }
  .sol:hover .sol__accent { transform: scaleX(1); }

  .casos {
    display: flex; align-items: center; justify-content: space-between; gap: 2rem;
    flex-wrap: wrap; padding: clamp(1.75rem, 4vw, 2.5rem);
    background: var(--ink-2); border: 1px solid var(--line); border-radius: var(--r-card);
  }
  .casos__text { max-width: 52ch; display: grid; gap: 0.6rem; }
  .casos__title { color: var(--paper); }
  .casos__link { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600; color: var(--brand-400); white-space: nowrap; }
  .casos__link svg { transition: transform 0.25s var(--ease); }
  .casos__link:hover svg { transform: translateX(4px); }

  .svc-cta__inner {
    background: var(--ink-2); border: 1px solid var(--line); border-radius: var(--r-card);
    padding: clamp(2rem, 5vw, 4rem); text-align: center; display: grid; justify-items: center; gap: 1.1rem;
  }
  .svc-cta__title { max-width: 22ch; }
  .svc-cta__lead { max-width: 56ch; }

  @media (max-width: 960px) {
    .grid--exp { grid-template-columns: repeat(2, 1fr); }
    .grid--sol { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .grid--exp { grid-template-columns: 1fr; }
  }
</style>
