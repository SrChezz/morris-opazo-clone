---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Morris & Opazo · Partner AWS que transforma negocios',
  description = 'Consultora cloud y Partner oficial de AWS. Transformamos negocios con Cloud Migration, Data & Analytics, Gen AI, Machine Learning e IoT. El partner que entiende tu industria.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0B0B12" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_CL" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Self-hosted fonts (no third-party CDN, no render-blocking external CSS).
         Preload the LCP-critical hero display weight; the rest load via fonts.css. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/spacegrotesk-700-latin.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/plusjakartasans-400-latin.woff2"
      crossorigin
    />
  </head>
  <body>
    <slot />
  </body>
</html>
